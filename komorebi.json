  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "mouse_follows_focus": false,
  "border": true,
  "border_width": 8,
  "border_offset": -1,
  "border_implementation": "Windows",
  "border_colours": {
    "single": "#00FFFF",
    "stack": "#00FFFF",
    "monocle": "#00FFFF",
    "floating": "#00FFFF",
    "unfocused": "#565E65"
  }
